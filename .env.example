# ===== WEBHOOK (penerima notif dari HP Android) =====
WEBHOOK_PORT=3000
# Token bebas, samakan dengan setting di MacroDroid/Tasker. Pakai random panjang.
WEBHOOK_TOKEN=ganti-dengan-token-acak-yang-panjang

# ===== WHATSAPP =====
# Nomor pemilik (yang boleh akses bot). Format internasional tanpa "+".
# Contoh: 6281234567890. Pisahkan banyak nomor pakai koma.
WA_OWNERS=6281234567890

# Nomor RESMI bank yang chat ke kamu via WA (jadi sumber transaksi tambahan).
# Pisahkan dengan koma. Contoh nomor di bawah ini ILUSTRATIF, ganti sesuai bankmu.
# Cek nomor resmi langsung di app/web bank ybs.
# WA_BANK_SOURCES=6281804500888,6281190001946
WA_BANK_SOURCES=

# ===== DB =====
DB_PATH=./data/finance.db

# ===== TIMEZONE =====
TZ=Asia/Jakarta
