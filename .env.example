# ===== IMAP (sumber notifikasi transaksi) =====
# Untuk Gmail: aktifkan 2FA lalu buat App Password (https://myaccount.google.com/apppasswords)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_TLS=true
IMAP_USER=youremail@gmail.com
IMAP_PASS=app-password-16-char
IMAP_MAILBOX=INBOX
# Polling interval dalam detik (kalau IDLE tidak tersedia)
IMAP_POLL_INTERVAL=60

# ===== WHATSAPP =====
# Nomor pemilik (yang boleh akses bot), format internasional tanpa + dan tanpa spasi
# contoh: 6281234567890. Pisahkan banyak nomor dengan koma.
WA_OWNERS=6281234567890

# ===== DB =====
DB_PATH=./data/finance.db

# ===== TIMEZONE =====
TZ=Asia/Jakarta
