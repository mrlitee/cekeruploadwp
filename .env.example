# ===== WHATSAPP (WAJIB) =====
# Nomor HP kamu (yang kirim perintah ke bot). Format: 628xxx tanpa "+"
WA_OWNERS=6281234567890

# Nomor resmi WA bank (opsional). Kalau kosong, bot auto-detect semua chat.
WA_BANK_SOURCES=

# Auto-detect transaksi dari semua pesan WA yang masuk (true/false)
# Kalau true: bot baca semua pesan masuk & coba parse. Aman, hanya catat yang cocok.
WA_AUTO_DETECT=true

# ===== ANDROID NOTIFICATION LISTENER =====
# Otomatis baca notif HP via termux-api (true/false). Butuh Termux:API terinstall.
NOTIF_LISTENER=true
# Interval polling notif (milliseconds)
NOTIF_INTERVAL_MS=5000

# ===== WEBHOOK (OPSIONAL - default OFF) =====
# Hidupkan hanya kalau mau pakai MacroDroid/Tasker juga.
WEBHOOK_ENABLED=false
WEBHOOK_PORT=3000
WEBHOOK_TOKEN=ganti-dengan-token-acak

# ===== DATABASE =====
DB_PATH=./data/finance.db

# ===== TIMEZONE =====
TZ=Asia/Jakarta
