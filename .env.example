# ====================================================================
#  WA FINANCE BOT — SUMBER UTAMA: EMAIL NOTIF BANK
# ====================================================================

# ===== WHATSAPP (WAJIB) =====
# Nomor HP yang akan menerima laporan & kirim perintah.
# Format: 628xxx tanpa "+", pisahkan dengan koma kalau lebih dari satu.
WA_OWNERS=6281234567890

# ===== EMAIL IMAP (WAJIB untuk auto-detect dari email bank) =====
EMAIL_ENABLED=true

# --- Gmail (paling umum) ---
# 1. Aktifkan 2-Step Verification di akun Google
# 2. Buat App Password 16 karakter: https://myaccount.google.com/apppasswords
# 3. Pakai App Password itu sebagai IMAP_PASS (BUKAN password Gmail biasa)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_TLS=true
IMAP_USER=youremail@gmail.com
IMAP_PASS=app-password-16-karakter
IMAP_MAILBOX=INBOX
IMAP_POLL_INTERVAL_MS=60000

# --- Provider lain ---
# Outlook/Hotmail:  imap-mail.outlook.com  port 993
# Yahoo Mail:       imap.mail.yahoo.com    port 993 (butuh App Password juga)
# Zoho:             imap.zoho.com          port 993

# ===== OPSIONAL: Auto-detect dari WA chat =====
WA_AUTO_DETECT=true
# Nomor WA resmi bank (kalau ada notif via WA), pisah koma. Contoh:
# WA_BANK_SOURCES=6281804500888,6281190001946
WA_BANK_SOURCES=

# ===== OPSIONAL: Notif Android via Termux:API (kalau jalan di HP) =====
NOTIF_LISTENER=false
NOTIF_INTERVAL_MS=5000

# ===== OPSIONAL: Webhook untuk MacroDroid =====
WEBHOOK_ENABLED=false
WEBHOOK_PORT=3000
WEBHOOK_TOKEN=ganti-jadi-random

# ===== STORAGE =====
DB_PATH=./data/finance.db

# ===== TIMEZONE =====
TZ=Asia/Jakarta
